{
  "name": "next-years-monsters-api",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Secure TypeScript backend for Next Year’s Monsters Monster Check live data.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm run test:typecheck && npm test",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:verify": "tsx src/database/verify.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "fastify": "^5.0.0",
    "pg": "^8.22.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
